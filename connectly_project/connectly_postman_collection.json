	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default values for variables if they don't exist",
					"if (!pm.environment.get('base_url')) {",
					"    pm.environment.set('base_url', 'http://127.0.0.1:8000');",
					"}",
					"",
					"// Log the request being made",
					"console.log('Making request to: ' + pm.request.url);",
					"console.log('Method: ' + pm.request.method);"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Common test script for all requests",
					"pm.test('Status code is 200 or 201', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
					"});",
					"",
					"pm.test('Response has valid JSON', function () {",
					"    pm.response.to.have.jsonBody();",
					"});",
					"",
					"// Store auth token if present in response",
					"if (pm.response.json().token) {",
					"    pm.environment.set('auth_token', pm.response.json().token);",
					"    console.log('Auth token stored successfully');",
					"}",
					"",
					"// Store user ID if present in response",
					"if (pm.response.json().user && pm.response.json().user.id) {",
					"    pm.environment.set('user_id', pm.response.json().user.id);",
					"    console.log('User ID stored: ' + pm.response.json().user.id);",
					"}",
					"",
					"// Store post ID if present in response",
					"if (pm.response.json().id && pm.request.url.path.includes('posts')) {",
					"    pm.environment.set('post_id', pm.response.json().id);",
					"    console.log('Post ID stored: ' + pm.response.json().id);",
					"}",
					"",
					"// Store comment ID if present in response",
					"if (pm.response.json().id && pm.request.url.path.includes('comments')) {",
					"    pm.environment.set('comment_id', pm.response.json().id);",
					"    console.log('Comment ID stored: ' + pm.response.json().id);",
					"}"
				]
			}
		}
